{
  "uid": "biomed-rag-overview",
  "title": "Biomedical Agentic RAG — Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_duration_milliseconds_count{exported_job=\"biomed-agentic-rag-backend\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP request latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket{exported_job=\"biomed-agentic-rag-backend\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{exported_job=\"biomed-agentic-rag-backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Agent tool calls, by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(tool_call_count_total{exported_job=\"biomed-agentic-rag-backend\"}[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool call error rate, by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(tool_call_count_total{exported_job=\"biomed-agentic-rag-backend\", outcome=\"error\"}[5m]))",
          "legendFormat": "{{tool}} errors"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tool call latency (p95), by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(tool_call_duration_seconds_bucket{exported_job=\"biomed-agentic-rag-backend\"}[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "RAG retrieval latency (p95), by domain",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, domain) (rate(rag_retrieve_duration_seconds_bucket{exported_job=\"biomed-agentic-rag-backend\"}[5m])))",
          "legendFormat": "{{domain}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "LLM call latency (p95), by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_call_duration_seconds_bucket{exported_job=\"biomed-agentic-rag-backend\"}[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM token usage, by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (rate(llm_token_usage_total{exported_job=\"biomed-agentic-rag-backend\"}[5m]))",
          "legendFormat": "{{token_type}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Process memory usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_usage_bytes{exported_job=\"biomed-agentic-rag-backend\"}",
          "legendFormat": "process memory"
        }
      ]
    },
    {
      "id": 10,
      "title": "Process CPU utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_utilization_ratio{exported_job=\"biomed-agentic-rag-backend\"}",
          "legendFormat": "process cpu"
        }
      ]
    }
  ]
}
