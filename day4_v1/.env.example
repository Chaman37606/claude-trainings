# Anthropic
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-opus-5
MODEL_CHEAP=claude-sonnet-5

# NCBI / PubMed E-utilities (email required by NCBI usage policy; API key raises rate limits)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# Semantic Scholar (optional, raises rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# ChEMBL has no auth requirement (public REST API)

# Vector store
CHROMA_PERSIST_DIR=backend/chroma_data

# Backend service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000

# Observability — empty disables it. Point at a local OTel Collector's OTLP
# gRPC endpoint to get traces + metrics (see docs/observability_setup.md).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=biomed-agentic-rag-backend
