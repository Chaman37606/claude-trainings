# Eli Lilly ALCOA+ QA System - Environment Configuration Template
# Copy this file to .env.production or .env.local and update values

# Database Configuration
# For SQLite (default local): sqlite:///./alcoa_qc.db
# For PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./alcoa_qc.db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=alcoa_qc
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Security (IMPORTANT: Change in production!)
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# Frontend Configuration
FRONTEND_URL=http://localhost:8080
FRONTEND_HOST=localhost
FRONTEND_PORT=8080

# Log Configuration
LOG_LEVEL=INFO
LOG_FILE=/tmp/alcoa_qc.log

# Session Configuration (in seconds)
SESSION_TIMEOUT=3600
REMEMBER_ME_TIMEOUT=2592000

# Compliance Settings
ALCOA_MODE=True
AUDIT_TRAIL_ENABLED=True

# Email Configuration (Optional)
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Feature Flags
ENABLE_USER_REGISTRATION=False
ENABLE_EXPORT_REPORTS=True
ENABLE_EMAIL_NOTIFICATIONS=False

# Rate Limiting
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Pagination
PAGE_SIZE=100
MAX_PAGE_SIZE=500
