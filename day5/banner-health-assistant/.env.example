# Copy to .env and adjust as needed. Every value here has a working default in
# backend/config.py — you only need this file to override something.
# `docker-compose` reads a `.env` file in this directory automatically; for a
# plain local `uvicorn` run, `export` these or use `python-dotenv` yourself.

# SQLAlchemy connection string. Default: a local SQLite file under backend/.
# Point this at Postgres (or similar) for real concurrent-write scale — see
# performance/PERFORMANCE_REVIEW.md for why SQLite's single-writer lock is the
# ceiling here, not the application code.
# DATABASE_URL=sqlite:////absolute/path/to/banner_health.db
# DATABASE_URL=postgresql://user:password@localhost:5432/banner_health

# Comma-separated list of allowed CORS origins. Default: * (any origin) — fine
# for a local demo, tighten this before exposing the API beyond localhost.
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Python logging level for the app logger.
# LOG_LEVEL=INFO

# Bind address/port for `uvicorn main:app --host $HOST --port $PORT`.
# HOST=127.0.0.1
# PORT=8000
